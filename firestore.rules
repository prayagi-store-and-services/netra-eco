rules_version = '2';
// Netra family shared Firestore (project netra-ai-jan). DRAFT for the owner to review and publish by hand.
// Goal: everyone can READ the public ratings/feedback/counters (the sites show them), but clients can only
// CREATE well-formed documents. No client edits or deletes. Anything not listed is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    // Public star ratings (embed.html and apps). Create only.
    match /netra_site_ratings/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['appId', 'stars', 'mode', 'createdAt'])
        && request.resource.data.keys().hasOnly(['appId', 'stars', 'mode', 'createdAt', 'name', 'place', 'comment', 'device', 'clientId', 'reported'])
        && request.resource.data.appId is string && request.resource.data.appId.size() <= 40
        && request.resource.data.stars is int && request.resource.data.stars >= 1 && request.resource.data.stars <= 5
        && request.resource.data.mode in ['name', 'anonymous']
        && (!('comment' in request.resource.data) || (request.resource.data.comment is string && request.resource.data.comment.size() <= 500))
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 60))
        && (!('place' in request.resource.data) || (request.resource.data.place is string && request.resource.data.place.size() <= 60))
        && (!('device' in request.resource.data) || (request.resource.data.device is string && request.resource.data.device.size() <= 60))
        && (!('clientId' in request.resource.data) || (request.resource.data.clientId is string && request.resource.data.clientId.size() <= 64))
        && (!('reported' in request.resource.data) || request.resource.data.reported == false || request.resource.data.reported == null);
      allow update, delete: if false;
    }

    // Public feedback. Create only.
    match /netra_site_feedback/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['appId', 'kind', 'message', 'createdAt'])
        && request.resource.data.keys().hasOnly(['appId', 'kind', 'message', 'createdAt', 'name', 'device', 'clientId'])
        && request.resource.data.appId is string && request.resource.data.appId.size() <= 40
        && request.resource.data.kind is string && request.resource.data.kind.size() <= 30
        && request.resource.data.message is string && request.resource.data.message.size() >= 1 && request.resource.data.message.size() <= 1000
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 60))
        && (!('device' in request.resource.data) || (request.resource.data.device is string && request.resource.data.device.size() <= 60))
        && (!('clientId' in request.resource.data) || (request.resource.data.clientId is string && request.resource.data.clientId.size() <= 64));
      allow update, delete: if false;
    }

    // Owner replies: readable by all, written only from the console / admin tools (they bypass these rules).
    match /netra_site_replies/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Anonymous active-user counters: the apps add exactly +1 to "count". Nothing else.
    match /netra_active/{id} {
      allow read: if true;
      allow create: if id.matches('^[a-z0-9-]+_[0-9]{6,8}$')
        && request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == 1;
      allow update: if id.matches('^[a-z0-9-]+_[0-9]{6,8}$')
        && request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == resource.data.count + 1;
      allow delete: if false;
    }

    // Everything else: closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
